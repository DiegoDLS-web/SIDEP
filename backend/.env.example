# =============================================================================
# SIDEP — Variables de entorno (backend)
# Copia este archivo a `.env` y completa los valores.
# =============================================================================

# --- Base de datos (obligatorio) ---
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# --- Autenticación (obligatorio en producción) ---
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
NODE_ENV=development

# --- CORS / URLs públicas ---
# Origen del frontend (desarrollo)
FRONTEND_URL=http://localhost:4200
# URL base del frontend para enlaces en correos (recuperar contraseña)
# En producción DEBE ser la URL pública real (ej. https://sidep.tucompania.cl), no localhost.
APP_PUBLIC_URL=http://localhost:4200

# --- SMTP — recuperación de contraseña (obligatorio para enviar correos) ---
# Sin estas tres variables verás: "El envío de correo no está configurado..."
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="SIDEP <tu-correo@gmail.com>"

# Ejemplo Outlook / Microsoft 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# --- Cloudinary (fotos, licencias, logo compañía) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Servidor ---
PORT=3000
