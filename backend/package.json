{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec \"node --stack-size=65500 ./node_modules/ts-node/dist/bin.js\" index.ts",
    "build": "node --stack-size=65500 ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "test": "node --test tests/**/*.test.js",
    "start": "node -r dotenv/config dist/index.js",
    "prisma:generate": "prisma generate --schema SRC/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema SRC/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema SRC/prisma/schema.prisma",
    "import:inventario": "npx ts-node scripts/import-inventario-santa-juana.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
