generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogoEstadoVoluntario {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @db.VarChar(50)
  nombre   String    @db.VarChar(100)
  activo   Int       @db.SmallInt
  usuarios Usuario[]

  @@map("catalogo_estado_voluntario")
}

model CatalogoCargoOficialidad {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @db.VarChar(50)
  nombre   String    @db.VarChar(100)
  activo   Int       @db.SmallInt
  usuarios Usuario[]

  @@map("catalogo_cargo_oficialidad")
}

model RolUsuario {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @db.VarChar(50)
  nombre   String    @db.VarChar(100)
  activo   Int       @db.SmallInt
  usuarios Usuario[]

  @@map("rol_usuario")
}

model CatalogoGrupoSanguineo {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @db.VarChar(50)
  nombre   String    @db.VarChar(100)
  activo   Int       @db.SmallInt
  usuarios Usuario[]

  @@map("catalogo_grupo_sanguineo")
}

model CatalogoEstadoLicencia {
  id          Int              @id @default(autoincrement())
  codigo      String           @unique @db.VarChar(50)
  nombre      String           @db.VarChar(100)
  descripcion String?          @db.VarChar(255)
  activo      Int              @db.SmallInt
  licencias   LicenciaMedica[]

  @@map("catalogo_estado_licencia")
}

model CatalogoMaterial {
  id                 Int                @id @default(autoincrement())
  codigo             String             @unique @db.VarChar(50)
  nombre             String             @db.VarChar(100)
  categoria          String?            @db.VarChar(100)
  unidad             String?            @db.VarChar(50)
  activo             Int                @db.SmallInt
  materialesPorCarro MaterialPorCarro[]
  stockBodega        StockBodega?
  movimientosBodega  MovimientoBodega[]

  @@map("catalogo_material")
}

model StockBodega {
  id          Int              @id @default(autoincrement())
  materialId  Int              @unique @map("material_id")
  cantidad    Int              @default(0)
  stockMinimo Int              @default(0) @map("stock_minimo")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  material    CatalogoMaterial @relation(fields: [materialId], references: [id])

  @@map("stock_bodega")
}

model MovimientoBodega {
  id              String           @id @db.VarChar(36)
  materialId      Int              @map("material_id")
  tipo            String           @db.VarChar(20)
  cantidad        Int
  cantidadAntes   Int              @map("cantidad_antes")
  cantidadDespues Int              @map("cantidad_despues")
  motivo          String?          @db.VarChar(255)
  usuarioRut      String?          @map("usuario_rut") @db.VarChar(20)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  material        CatalogoMaterial @relation(fields: [materialId], references: [id])
  usuario         Usuario?         @relation(fields: [usuarioRut], references: [rut])

  @@index([materialId])
  @@index([createdAt])
  @@map("movimiento_bodega")
}

model CatalogoBodega {
  id     Int             @id @default(autoincrement())
  codigo String          @unique @db.VarChar(50)
  nombre String          @db.VarChar(100)
  activo Int             @db.SmallInt
  items  InventarioItem[]

  @@map("catalogo_bodega")
}

model InventarioItem {
  id             Int                        @id @default(autoincrement())
  codigo         String                     @unique @db.VarChar(50)
  nombre         String                     @db.VarChar(200)
  categoria      String?                    @db.VarChar(100)
  tipoInventario String?                    @map("tipo_inventario") @db.VarChar(80)
  /// Agrupa EPP del mismo tipo (BOTA_ESTRUCTURAL, CHAQUETA_RESCATE, GORRA, etc.)
  tipoEpp        String?                    @map("tipo_epp") @db.VarChar(80)
  /// Talla: 35-46 (botas) o XS-XXL (ropa/gorras)
  talla          String?                    @db.VarChar(10)
  /// BOTA | ROPA | null
  sistemaTalla   String?                    @map("sistema_talla") @db.VarChar(20)
  bodegaId       Int                        @map("bodega_id")
  marca          String?                    @db.VarChar(100)
  modelo         String?                    @db.VarChar(100)
  estadoFisico   String?                    @map("estado_fisico") @db.VarChar(50)
  valor          Decimal?                   @db.Decimal(14, 2)
  observaciones  String?                    @db.Text
  unidad         String                     @default("unidades") @db.VarChar(50)
  cantidad       Int                        @default(0)
  stockMinimo    Int                        @default(0) @map("stock_minimo")
  stockCritico   Int                        @default(0) @map("stock_critico")
  esEppAsignable Int                        @default(0) @map("es_epp_asignable") @db.SmallInt
  activo         Int                        @db.SmallInt
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bodega         CatalogoBodega             @relation(fields: [bodegaId], references: [id])
  asignaciones   AsignacionInventarioEpp[]
  movimientos    InventarioMovimiento[]

  @@index([bodegaId])
  @@index([categoria])
  @@index([tipoInventario])
  @@index([tipoEpp])
  @@index([talla])
  @@map("inventario_item")
}

model AsignacionInventarioEpp {
  id               String         @id @db.VarChar(36)
  inventarioItemId Int            @map("inventario_item_id")
  usuarioRut       String         @map("usuario_rut") @db.VarChar(20)
  cantidad         Int            @default(1)
  observaciones    String?        @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  inventarioItem   InventarioItem @relation(fields: [inventarioItemId], references: [id], onDelete: Cascade)
  usuario          Usuario        @relation(fields: [usuarioRut], references: [rut])

  @@unique([inventarioItemId, usuarioRut])
  @@index([usuarioRut])
  @@index([inventarioItemId])
  @@map("asignacion_inventario_epp")
}

model InventarioMovimiento {
  id               String         @id @db.VarChar(36)
  inventarioItemId Int            @map("inventario_item_id")
  tipo             String         @db.VarChar(20)
  cantidad         Int
  cantidadAntes    Int            @map("cantidad_antes")
  cantidadDespues  Int            @map("cantidad_despues")
  motivo           String?        @db.VarChar(255)
  usuarioRut       String?        @map("usuario_rut") @db.VarChar(20)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  inventarioItem   InventarioItem @relation(fields: [inventarioItemId], references: [id], onDelete: Cascade)
  usuario          Usuario?       @relation("InventarioMovimientoUsuario", fields: [usuarioRut], references: [rut])

  @@index([inventarioItemId])
  @@index([createdAt])
  @@map("inventario_movimiento")
}

model CatalogoBolso {
  id     Int           @id @default(autoincrement())
  codigo String        @unique @db.VarChar(50)
  nombre String        @db.VarChar(100)
  activo Int           @db.SmallInt
  bolsos BolsoTrauma[]

  @@map("catalogo_bolso")
}

model CatalogoTriage {
  id        Int                  @id @default(autoincrement())
  codigo    String               @unique @db.VarChar(50)
  nombre    String               @db.VarChar(100)
  color     String?              @db.VarChar(50)
  activo    Int                  @db.SmallInt
  pacientes PacienteEmergencia[]

  @@map("catalogo_triage")
}

model CatalogoEstadoParte {
  id          Int               @id @default(autoincrement())
  codigo      String            @unique @db.VarChar(50)
  nombre      String            @db.VarChar(100)
  descripcion String?           @db.VarChar(255)
  activo      Int               @db.SmallInt
  partes      ParteEmergencia[]

  @@map("catalogo_estado_parte")
}

model CatalogoClaveEmergencia {
  id          Int               @id @default(autoincrement())
  codigo      String            @unique @db.VarChar(50)
  nombre      String            @db.VarChar(100)
  descripcion String?           @db.VarChar(255)
  activo      Int               @db.SmallInt
  partes      ParteEmergencia[]

  @@map("catalogo_clave_emergencia")
}

model CatalogoTipoVoluntario {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @db.VarChar(50)
  nombre   String    @db.VarChar(100)
  activo   Int       @db.SmallInt
  usuarios Usuario[]

  @@map("catalogo_tipo_voluntario")
}

model Usuario {
  rut                     String                    @id @db.VarChar(20)
  nombres                 String                    @db.VarChar(100)
  apellidoPaterno         String                    @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno         String                    @map("apellido_materno") @db.VarChar(100)
  email                   String                    @unique @db.VarChar(150)
  passwordHash            String                    @map("password_hash") @db.VarChar(255)
  fotoPerfilUrl           String?                   @map("foto_perfil_url")
  fotoPerfilPublicId      String?                   @map("foto_perfil_public_id")
  firmaImagenUrl          String?                   @map("firma_imagen_url")
  firmaImagenPublicId      String?                   @map("firma_imagen_public_id")
  rolId                   Int                       @map("rol_id")
  cargoId                 Int?                      @map("cargo_id")
  tipoVoluntarioId        Int?                      @map("tipo_voluntario_id")
  estadoVoluntarioId      Int?                      @map("estado_voluntario_id")
  grupoSanguineoId        Int?                      @map("grupo_sanguineo_id")
  compania                String?                   @db.VarChar(100)
  cuerpoBombero           String?                   @map("cuerpo_bombero") @db.VarChar(150)
  activo                  Int                       @db.SmallInt
  telefono                String?                   @db.VarChar(50)
  direccion               String?                   @db.VarChar(255)
  region                  String?                   @db.VarChar(100)
  comuna                  String?                   @db.VarChar(100)
  actividad               String?                   @db.VarChar(100)
  nacionalidad            String?                   @db.VarChar(100)
  fechaNacimiento         DateTime?                 @map("fecha_nacimiento") @db.Date
  fechaIngreso            DateTime?                 @map("fecha_ingreso") @db.Date
  autorizadoConducir      Int?                      @default(0) @map("autorizado_conducir") @db.SmallInt
  claveNomina             String?                   @unique @map("clave_nomina") @db.VarChar(50)
  requiereCambioPassword  Int                       @default(0) @map("requiere_cambio_password") @db.SmallInt
  tokenVersion            Int                       @default(0) @map("token_version")
  mfaSecret               String?                   @map("mfa_secret") @db.VarChar(128)
  mfaEnabled              Int                       @default(0) @map("mfa_enabled") @db.SmallInt
  observacionesRegistro   String?                   @map("observaciones_registro") @db.Text
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  asistencias             AsistenciaPersonal[]
  auditorias              AuditoriaUsuario[]
  checklists              ChecklistEjecucion[]
  movimientosBodega       MovimientoBodega[]
  asignacionesInventarioEpp AsignacionInventarioEpp[]
  inventarioMovimientos   InventarioMovimiento[]    @relation("InventarioMovimientoUsuario")
  licenciasResueltas      LicenciaMedica[]          @relation("LicenciaMedica_resuelto")
  licenciasPropias        LicenciaMedica[]          @relation("LicenciaMedica_usuario")
  guardiasComoCuartelero  GuardiaTurno[]            @relation("GuardiaCuartelero")
  guardiasComoObac        GuardiaTurno[]            @relation("GuardiaObac")
  guardiasRegistradas     GuardiaTurno[]            @relation("GuardiaRegistrador")
  guardiaMiembros         GuardiaMiembro[]
  novedadesLibro          LibroNovedad[]
  asistenciasCuartel      AsistenciaCuartelero[]    @relation("AsistenciaCuarteleroUsuario")
  asistenciasCuartelReg   AsistenciaCuartelero[]    @relation("AsistenciaCuarteleroRegistrador")
  mantenimientosConductor MantenimientoCarro[]      @relation("conductor")
  mantenimientosInspector MantenimientoCarro[]      @relation("inspector")
  partesObac              ParteEmergencia[]
  passwordResetTokens     PasswordResetToken[]
  unidadesConductor       UnidadEnEmergencia[]
  cargo                   CatalogoCargoOficialidad? @relation(fields: [cargoId], references: [id])
  estadoVoluntario        CatalogoEstadoVoluntario? @relation(fields: [estadoVoluntarioId], references: [id])
  grupoSanguineo          CatalogoGrupoSanguineo?   @relation(fields: [grupoSanguineoId], references: [id])
  rol                     RolUsuario                @relation(fields: [rolId], references: [id])
  tipoVoluntario          CatalogoTipoVoluntario?   @relation(fields: [tipoVoluntarioId], references: [id])

  @@map("usuario")
}

model Carro {
  id                 String               @id @db.VarChar(36)
  patente            String?              @unique @db.VarChar(20)
  nomenclatura       String               @unique @db.VarChar(50)
  nombre             String               @db.VarChar(100)
  marca              String?              @db.VarChar(100)
  kilometraje        Decimal?             @db.Decimal(10, 1)
  estadoOperativo    Int                  @map("estado_operativo") @db.SmallInt
  motivoFueraServicio String?             @map("motivo_fuera_servicio") @db.Text
  fueraServicioDesde  DateTime?           @map("fuera_servicio_desde") @db.Timestamptz(6)
  bolsos             BolsoTrauma[]
  mantenimientos     MantenimientoCarro[]
  materiales         MaterialPorCarro[]
  unidadesEmergencia UnidadEnEmergencia[]

  @@map("carro")
}

model ParteEmergencia {
  id                String                    @id @db.VarChar(36)
  correlativo       String                    @unique @db.VarChar(50)
  estadoId          Int                       @map("estado_id")
  fechaEmergencia   DateTime                  @map("fecha_emergencia") @db.Timestamptz(6)
  claveId           Int                       @map("clave_id")
  obacRut           String                    @map("obac_rut") @db.VarChar(20)
  direccion         String                    @db.VarChar(200)
  referenciaLugar   String?                   @map("referencia_lugar") @db.VarChar(255)
  trabajoRealizado  String?                   @map("trabajo_realizado")
  materialUtilizado String?                   @map("material_utilizado")
  metadata          String?
  firmaObac         String?                   @map("firma_obac")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  asistencias       AsistenciaPersonal[]
  pacientes         PacienteEmergencia[]
  clave             CatalogoClaveEmergencia   @relation(fields: [claveId], references: [id])
  estado            CatalogoEstadoParte       @relation(fields: [estadoId], references: [id])
  obac              Usuario                   @relation(fields: [obacRut], references: [rut])
  unidades          UnidadEnEmergencia[]
  vehiculosCiviles  VehiculoCivilEmergencia[]

  @@index([fechaEmergencia])
  @@index([estadoId])
  @@index([claveId])
  @@index([obacRut])
  @@map("parte_emergencia")
}

model PacienteEmergencia {
  id          String          @id @db.VarChar(36)
  parteId     String          @map("parte_id") @db.VarChar(36)
  nombre      String          @db.VarChar(150)
  rutPaciente String?         @map("rut_paciente") @db.VarChar(20)
  triageId    Int             @map("triage_id")
  parte       ParteEmergencia @relation(fields: [parteId], references: [id])
  triage      CatalogoTriage  @relation(fields: [triageId], references: [id])

  @@map("paciente_emergencia")
}

model VehiculoCivilEmergencia {
  id           String          @id @db.VarChar(36)
  parteId      String          @map("parte_id") @db.VarChar(36)
  patente      String?         @db.VarChar(20)
  marca        String?         @db.VarChar(50)
  conductor    String?         @db.VarChar(150)
  rutConductor String?         @map("rut_conductor") @db.VarChar(20)
  parte        ParteEmergencia @relation(fields: [parteId], references: [id])

  @@map("vehiculo_civil_emergencia")
}

model AsistenciaPersonal {
  id         String          @id @db.VarChar(36)
  parteId    String          @map("parte_id") @db.VarChar(36)
  usuarioRut String          @map("usuario_rut") @db.VarChar(20)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  parte      ParteEmergencia @relation(fields: [parteId], references: [id])
  usuario    Usuario         @relation(fields: [usuarioRut], references: [rut])

  @@unique([parteId, usuarioRut])
  @@index([parteId])
  @@index([usuarioRut])
  @@map("asistencia_personal")
}

model UnidadEnEmergencia {
  id           String          @id @db.VarChar(36)
  parteId      String          @map("parte_id") @db.VarChar(36)
  carroId      String          @map("carro_id") @db.VarChar(36)
  conductorRut String?         @map("conductor_rut") @db.VarChar(20)
  horaSalida   DateTime        @map("hora_salida") @db.Timestamptz(6)
  horaLlegada  DateTime        @map("hora_llegada") @db.Timestamptz(6)
  kmSalida     Decimal         @map("km_salida") @db.Decimal(10, 1)
  kmLlegada    Decimal         @map("km_llegada") @db.Decimal(10, 1)
  carro        Carro           @relation(fields: [carroId], references: [id])
  conductor    Usuario?        @relation(fields: [conductorRut], references: [rut])
  parte        ParteEmergencia @relation(fields: [parteId], references: [id])

  @@index([parteId])
  @@index([carroId])
  @@map("unidad_en_emergencia")
}

model MaterialPorCarro {
  id               String           @id @db.VarChar(36)
  carroId          String           @map("carro_id") @db.VarChar(36)
  materialId       Int              @map("material_id")
  cantidadObjetivo Int              @map("cantidad_objetivo")
  ubicacion        String?          @db.VarChar(100)
  activo           Int              @db.SmallInt
  carro            Carro            @relation(fields: [carroId], references: [id])
  material         CatalogoMaterial @relation(fields: [materialId], references: [id])

  @@unique([carroId, materialId, ubicacion])
  @@map("material_por_carro")
}

model BolsoTrauma {
  id                  String        @id @db.VarChar(36)
  tipoId              Int           @map("tipo_id")
  carroId             String        @map("carro_id") @db.VarChar(36)
  nombreIdentificador String?       @map("nombre_identificador") @db.VarChar(100)
  activo              Int           @db.SmallInt
  carro               Carro         @relation(fields: [carroId], references: [id])
  catalogoBolso       CatalogoBolso @relation(fields: [tipoId], references: [id])

  @@map("bolso_trauma")
}

model ChecklistPlantilla {
  id             String               @id @db.VarChar(36)
  codigo         String               @unique @db.VarChar(50)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  descripcion    String?
  entidadTipo    String               @map("entidad_tipo") @db.VarChar(50)
  estructuraJson String               @map("estructura_json")
  nombre         String               @db.VarChar(150)
  version        Int
  activo         Int                  @db.SmallInt
  ejecuciones    ChecklistEjecucion[]

  @@map("checklist_plantilla")
}

model ChecklistEjecucion {
  id             String             @id @db.VarChar(36)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  entidadId      String             @map("entidad_id") @db.VarChar(36)
  entidadTipo    String             @map("entidad_tipo") @db.VarChar(50)
  estado         String             @db.VarChar(30)
  fechaRevision  DateTime           @map("fecha_revision") @db.Timestamptz(6)
  firmaOficial   String?            @map("firma_oficial")
  firmaRevisor   String?            @map("firma_revisor")
  plantillaId    String             @map("plantilla_id") @db.VarChar(36)
  respuestasJson String             @map("respuestas_json")
  revisorRut     String             @map("revisor_rut") @db.VarChar(20)
  plantilla      ChecklistPlantilla @relation(fields: [plantillaId], references: [id])
  revisor        Usuario            @relation(fields: [revisorRut], references: [rut])

  @@index([entidadId, entidadTipo])
  @@index([fechaRevision])
  @@map("checklist_ejecucion")
}

model MantenimientoCarro {
  id                        String    @id @db.VarChar(36)
  carroId                   String    @map("carro_id") @db.VarChar(36)
  fechaRegistro             DateTime  @map("fecha_registro") @db.Timestamptz(6)
  fechaMantenimiento        DateTime? @map("fecha_mantenimiento") @db.Date
  fechaProximoMantenimiento DateTime? @map("fecha_proximo_mantenimiento") @db.Date
  fechaProximaRevTecnica    DateTime? @map("fecha_proxima_rev_tecnica") @db.Date
  fechaRevBomba             DateTime? @map("fecha_rev_bomba") @db.Date
  fechaInspeccion           DateTime? @map("fecha_inspeccion") @db.Date
  inspectorRut              String?   @map("inspector_rut") @db.VarChar(20)
  conductorRut              String?   @map("conductor_rut") @db.VarChar(20)
  inspectorNombre           String?   @map("inspector_nombre") @db.VarChar(100)
  conductorNombre           String?   @map("conductor_nombre") @db.VarChar(100)
  firmaInspector            String?   @map("firma_inspector") @db.Text
  descripcion               String?
  carro                     Carro     @relation(fields: [carroId], references: [id])
  conductor                 Usuario?  @relation("conductor", fields: [conductorRut], references: [rut])
  inspector                 Usuario?  @relation("inspector", fields: [inspectorRut], references: [rut])

  @@map("mantenimiento_carro")
}

model LicenciaMedica {
  id                    String                 @id @db.VarChar(36)
  usuarioRut            String                 @map("usuario_rut") @db.VarChar(20)
  resolutorRut          String?                @map("resolutor_rut") @db.VarChar(20)
  estadoLicenciaId      Int                    @map("estado_licencia_id")
  fechaInicio           DateTime               @map("fecha_inicio") @db.Date
  fechaTermino          DateTime               @map("fecha_termino") @db.Date
  motivo                String                 @db.VarChar(255)
  archivoUrl            String?                @map("archivo_url") @db.VarChar(255)
  archivoPublicId       String?                @map("archivo_public_id") @db.VarChar(255)
  observacionResolucion String?                @map("observacion_resolucion")
  resueltoEn            DateTime?              @map("resuelto_en") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  estado                CatalogoEstadoLicencia @relation(fields: [estadoLicenciaId], references: [id])
  resolutor             Usuario?               @relation("LicenciaMedica_resuelto", fields: [resolutorRut], references: [rut])
  usuario               Usuario                @relation("LicenciaMedica_usuario", fields: [usuarioRut], references: [rut])

  @@index([usuarioRut])
  @@index([fechaInicio, fechaTermino])
  @@index([estadoLicenciaId])
  @@map("licencia_medica")
}

model AuditoriaUsuario {
  id         String   @id @db.VarChar(36)
  usuarioRut String?  @map("usuario_rut") @db.VarChar(20)
  accion     String   @db.VarChar(100)
  entidad    String?  @db.VarChar(100)
  entidadId  String?  @map("entidad_id") @db.VarChar(36)
  metodoHttp String?  @map("metodo_http") @db.VarChar(10)
  ruta       String?  @db.VarChar(255)
  ipOrigen   String?  @map("ip_origen") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  detalle    String?
  resultado  String   @db.VarChar(30)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario    Usuario? @relation(fields: [usuarioRut], references: [rut])

  @@map("auditoria_usuario")
}

model ConfiguracionSistema {
  id                     Int       @id @default(autoincrement())
  nombreCompania         String    @map("nombre_compania") @db.VarChar(150)
  nombreBomba            String?   @map("nombre_bomba") @db.VarChar(150)
  direccion              String?   @db.VarChar(255)
  telefono               String?   @db.VarChar(50)
  emailInstitucional     String?   @map("email_institucional") @db.VarChar(150)
  fechaFundacion         DateTime? @map("fecha_fundacion") @db.Date
  logoUrl                String?   @map("logo_url")
  logoPublicId           String?   @map("logo_public_id")
  
  alertasEmergencia      Int       @default(1) @map("alertas_emergencia") @db.SmallInt
  alertasInventario      Int       @default(1) @map("alertas_inventario") @db.SmallInt
  recordatoriosChecklist Int       @default(1) @map("recordatorios_checklist") @db.SmallInt
  resumenDiarioEmail     Int       @default(1) @map("resumen_diario_email") @db.SmallInt
  
  formatoPredeterminado  String    @default("PDF") @map("formato_predeterminado") @db.VarChar(10)
  logosPdf               String    @default("AMBOS") @map("logos_pdf") @db.VarChar(20)
  orientacionPdf         String    @default("VERTICAL") @map("orientacion_pdf") @db.VarChar(20)
  
  navegacionPorRol       String?   @map("navegacion_por_rol") @db.Text
  tiposEmergencia        String?   @map("tipos_emergencia") @db.Text

  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("configuracion_sistema")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token      String    @unique @db.VarChar(64)
  usuarioRut String    @map("usuario_rut") @db.VarChar(20)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario    Usuario   @relation(fields: [usuarioRut], references: [rut], onDelete: Cascade)

  @@index([usuarioRut])
  @@map("password_reset_token")
}

model EmailNotificacionLog {
  id           Int      @id @default(autoincrement())
  tipo         String   @db.VarChar(80)
  destinatario String   @db.VarChar(150)
  subject      String   @db.VarChar(255)
  ok           Int      @db.SmallInt
  detalle      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("email_notificacion_log")
}

model GuardiaTurno {
  id               String           @id @db.VarChar(36)
  fecha            DateTime         @db.Date
  grupo            String           @db.VarChar(10)
  tipoTurno        String           @default("24H") @map("tipo_turno") @db.VarChar(20)
  cuarteleroRut    String?          @map("cuartelero_rut") @db.VarChar(20)
  obacRut          String?          @map("obac_rut") @db.VarChar(20)
  observaciones    String?          @db.Text
  registradoPorRut String           @map("registrado_por_rut") @db.VarChar(20)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  cuartelero       Usuario?         @relation("GuardiaCuartelero", fields: [cuarteleroRut], references: [rut])
  obac             Usuario?         @relation("GuardiaObac", fields: [obacRut], references: [rut])
  registradoPor    Usuario          @relation("GuardiaRegistrador", fields: [registradoPorRut], references: [rut])
  miembros         GuardiaMiembro[]

  @@unique([fecha, grupo])
  @@index([fecha])
  @@map("guardia_turno")
}

model GuardiaMiembro {
  id           String       @id @db.VarChar(36)
  guardiaId    String       @map("guardia_id") @db.VarChar(36)
  usuarioRut   String       @map("usuario_rut") @db.VarChar(20)
  rolEnGuardia String?      @map("rol_en_guardia") @db.VarChar(50)
  guardia      GuardiaTurno @relation(fields: [guardiaId], references: [id], onDelete: Cascade)
  usuario      Usuario      @relation(fields: [usuarioRut], references: [rut])

  @@unique([guardiaId, usuarioRut])
  @@map("guardia_miembro")
}

model LibroNovedad {
  id           String   @id @db.VarChar(36)
  fechaHora    DateTime @map("fecha_hora") @db.Timestamptz(6)
  categoria    String   @db.VarChar(50)
  titulo       String   @db.VarChar(200)
  descripcion  String   @db.Text
  grupoGuardia String?  @map("grupo_guardia") @db.VarChar(10)
  importante   Int      @default(0) @db.SmallInt
  autorRut     String   @map("autor_rut") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  autor        Usuario  @relation(fields: [autorRut], references: [rut])

  @@index([fechaHora(sort: Desc)])
  @@index([categoria])
  @@map("libro_novedad")
}

model AsistenciaCuartelero {
  id               String   @id @db.VarChar(36)
  fecha            DateTime @db.Date
  usuarioRut       String   @map("usuario_rut") @db.VarChar(20)
  grupoGuardia     String?  @map("grupo_guardia") @db.VarChar(10)
  tipoTurno        String   @default("DIURNA") @map("tipo_turno") @db.VarChar(20)
  estadoAsistencia String   @default("ASISTE") @map("estado_asistencia") @db.VarChar(30)
  presente         Int      @default(1) @db.SmallInt
  horaEntrada      String?  @map("hora_entrada") @db.VarChar(5)
  horaSalida       String?  @map("hora_salida") @db.VarChar(5)
  observaciones    String?  @db.Text
  registradoPorRut String   @map("registrado_por_rut") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  usuario          Usuario  @relation("AsistenciaCuarteleroUsuario", fields: [usuarioRut], references: [rut])
  registradoPor    Usuario  @relation("AsistenciaCuarteleroRegistrador", fields: [registradoPorRut], references: [rut])

  @@unique([fecha, usuarioRut, tipoTurno])
  @@index([fecha])
  @@map("asistencia_cuartelero")
}
